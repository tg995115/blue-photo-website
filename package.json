{
  "name": "blue-photo-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --site-url https://dusskapark.github.io/blue-photo-website/ --out-dir dist-pages",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/serve.mjs",
    "preview:pages": "node scripts/serve.mjs --dir dist-pages --base /blue-photo-website --port 4174",
    "test:pages": "node --test test/pages-build.test.mjs",
    "test": "node --test test/download.test.mjs"
  },
  "dependencies": {
    "@paper-design/shaders-react": "0.0.81",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
