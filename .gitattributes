# Legal documents are hash-verified, so text files must keep LF in every checkout.
* text=auto eol=lf

# Preserve the official SVG bytes, including Microsoft's CRLF line endings.
# The second path covers the same badges inside the published dist-pages tree.
public/assets/badges/*.svg -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
assets/badges/*.svg -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
